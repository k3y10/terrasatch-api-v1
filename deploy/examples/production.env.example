# Copy to /etc/terrasatch/api.env, set mode 0600, and replace every placeholder.
TERRASATCH_ENV=production
TERRASATCH_DEPLOYMENT_NAME=primary
TERRASATCH_API_BASE_URL=https://api.terrasatch.com
TERRASATCH_DATABASE_URL=postgresql+asyncpg://<user>:<password>@<postgres-host>:5432/<database>
TERRASATCH_REDIS_URL=redis://<redis-host>:6379/0
TERRASATCH_LOG_LEVEL=INFO
TERRASATCH_LOG_FORMAT=json
TERRASATCH_CORS_ORIGINS=https://terrasatch.com,https://relay.terrasatch.com
TERRASATCH_ENABLE_DOCS=false

# Registration guardrails. Hitting a limit pauses new registrations without
# interrupting existing Edge heartbeats, ingestion, or signed-in portal users.
TERRASATCH_MAX_EDGE_DEVICES=100
TERRASATCH_MAX_PORTAL_USERS=250

# Generate these through `terrasatch admin configure` on a secured host or
# through an approved secret manager. Never commit actual values.
TERRASATCH_ADMIN_EMAIL=admin@example.com
TERRASATCH_ADMIN_PASSWORD_HASH=scrypt$16384$8$1$replace-with-generated-value
TERRASATCH_ADMIN_SESSION_SECRET=replace-with-generated-value