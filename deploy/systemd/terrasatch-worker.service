[Unit]
Description=TerraSatch Background Worker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=terrasatch
Group=terrasatch
WorkingDirectory=/opt/terrasatch-ai-radio-core
EnvironmentFile=/etc/terrasatch/api.env
ExecStart=/opt/terrasatch-ai-radio-core/.venv/bin/terrasatch worker
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target