# Environment: local, development, staging, or production.
TERRASATCH_ENV=local
TERRASATCH_DEPLOYMENT_NAME=local
# Deployment tooling may set TERRASATCH_BUILD_SHA at runtime. Do not hard-code
# it in production .env; deploy/release-oracle.sh stamps the current Git revision.
# TERRASATCH_BUILD_SHA=unknown
TERRASATCH_API_BASE_URL=http://localhost:8000
TERRASATCH_DATABASE_URL=postgresql+asyncpg://terrasatch:terrasatch@localhost:5432/terrasatch
TERRASATCH_REDIS_URL=redis://localhost:6379/0
TERRASATCH_LOG_LEVEL=INFO
TERRASATCH_LOG_FORMAT=json
TERRASATCH_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:4173,http://127.0.0.1:4173
# Set true only when API documentation may be exposed to the public.
TERRASATCH_ENABLE_DOCS=true
# Optional read-only UAC historical archive. On Oracle/Compose, point the host
# directory at persistent storage and keep the in-container path stable.
# TERRASATCH_UAC_ARCHIVE_HOST_DIR=/opt/terrasatch/data/uac
# TERRASATCH_UAC_ARCHIVE_PATH=/var/lib/terrasatch/uac/avalanches.csv

# External provider integrations. Never expose these through VITE_* variables.
# Generate the encryption key once, store it in the Oracle owner-only environment,
# and keep it stable or existing connected-provider credentials will be unreadable.
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# TERRASATCH_INTEGRATION_ENCRYPTION_KEY=<fernet-key>
# Preferred provider-app configuration: inject one secret JSON bundle from OCI Vault or your
# deployment secret store. Customer OAuth tokens are NOT stored here; they remain per-connection.
# Example shape (keep the real JSON in a secret manager, not this file):
# {"google_drive":{"client_id":"...","client_secret":"...","redirect_uri":"https://api.terrasatch.com/api/v1/workspace/integrations/oauth/google_drive/callback"},"google_calendar":{"client_id":"...","client_secret":"...","redirect_uri":"https://api.terrasatch.com/api/v1/workspace/integrations/oauth/google_calendar/callback"},"microsoft_365":{"client_id":"...","client_secret":"...","redirect_uri":"https://api.terrasatch.com/api/v1/workspace/integrations/oauth/microsoft_365/callback"},"microsoft_calendar":{"client_id":"...","client_secret":"...","redirect_uri":"https://api.terrasatch.com/api/v1/workspace/integrations/oauth/microsoft_calendar/callback"},"jira":{"client_id":"...","client_secret":"...","redirect_uri":"https://api.terrasatch.com/api/v1/workspace/integrations/oauth/jira/callback"},"confluence":{"client_id":"...","client_secret":"...","redirect_uri":"https://api.terrasatch.com/api/v1/workspace/integrations/oauth/confluence/callback"},"slack":{"client_id":"...","client_secret":"...","redirect_uri":"https://api.terrasatch.com/api/v1/workspace/integrations/oauth/slack/callback"},"esri_arcgis":{"client_id":"...","client_secret":"...","redirect_uri":"https://api.terrasatch.com/api/v1/workspace/integrations/oauth/esri_arcgis/callback"},"mapbox":{"access_token":"...","username":"terrasatch","style_ids":"field-style,incident-style"}}
# TERRASATCH_INTEGRATION_PROVIDER_CONFIG_JSON=<secret-json-bundle>
TERRASATCH_INTEGRATION_ENCRYPTION_KEY_ID=v1
TERRASATCH_INTEGRATION_OAUTH_STATE_TTL_MINUTES=10
TERRASATCH_INTEGRATION_RETURN_URL=https://terrasatch.com/workspace?view=Integrations
# Legacy/local compatibility fallback. Prefer TERRASATCH_INTEGRATION_PROVIDER_CONFIG_JSON.
# Google Cloud: enable Drive API and register this exact Web application redirect URI.
# TERRASATCH_GOOGLE_OAUTH_CLIENT_ID=
# TERRASATCH_GOOGLE_OAUTH_CLIENT_SECRET=
# TERRASATCH_GOOGLE_OAUTH_REDIRECT_URI=https://api.terrasatch.com/api/v1/workspace/integrations/oauth/google_drive/callback
# Slack: configure this exact OAuth Redirect URL in the TerraSatch Slack app.
# TERRASATCH_SLACK_OAUTH_CLIENT_ID=
# TERRASATCH_SLACK_OAUTH_CLIENT_SECRET=
# TERRASATCH_SLACK_OAUTH_REDIRECT_URI=https://api.terrasatch.com/api/v1/workspace/integrations/oauth/slack/callback
# ArcGIS Online: create server-side OAuth credentials and register this callback.
# TERRASATCH_ARCGIS_OAUTH_CLIENT_ID=
# TERRASATCH_ARCGIS_OAUTH_CLIENT_SECRET=
# TERRASATCH_ARCGIS_OAUTH_REDIRECT_URI=https://api.terrasatch.com/api/v1/workspace/integrations/oauth/esri_arcgis/callback

# Subscription billing is OFF by default. Keep this false until the separate
# The dedicated TerraSatch Stripe account has test-mode products, prices,
# Customer Portal configuration, and a verified webhook endpoint.
TERRASATCH_BILLING_ENABLED=false
# Keep live-mode Stripe events disabled through the entire test rollout. This is
# a second explicit gate and should be enabled only after the production review.
TERRASATCH_BILLING_ALLOW_LIVEMODE=false
TERRASATCH_BILLING_GRACE_DAYS=7
TERRASATCH_BILLING_CHECKOUT_TTL_MINUTES=120
TERRASATCH_BILLING_ACTIVATION_TTL_HOURS=24
TERRASATCH_BILLING_SUCCESS_URL=https://terrasatch.com/billing/success?session_id={CHECKOUT_SESSION_ID}
TERRASATCH_BILLING_CANCEL_URL=https://terrasatch.com/#cost
TERRASATCH_BILLING_PORTAL_RETURN_URL=https://api.terrasatch.com/portal
TERRASATCH_BILLING_ACTIVATION_URL=https://terrasatch.com/activate
# Stripe secrets belong only on the API/Oracle side and must never be exposed
# through VITE_* variables or committed to Git.
# TERRASATCH_STRIPE_SECRET_KEY=sk_test_...
# Production requires the Stripe webhook signing secret below. Isolated staging
# may omit it only when using a test-mode Stripe key; staging then verifies each
# received evt_* by retrieving that exact event from Stripe before processing.
# TERRASATCH_STRIPE_WEBHOOK_SECRET=whsec_...
# Preferred transactional billing email: the durable Oracle worker sends directly
# through the separate TerraSatch Resend account. Staging and production are not
# billing-ready unless a sender and signed Resend delivery webhook are configured.
# The From address must use the verified terrasatch.com sending domain.
# TERRASATCH_RESEND_API_KEY=re_...
# TERRASATCH_RESEND_WEBHOOK_SECRET=whsec_...
# Configure the signed Resend webhook at:
#   https://api.terrasatch.com/api/v1/billing/resend/webhook
# Enable both the existing delivery events and `email.received`. The same verified
# webhook now reconciles outbound delivery status and stores inbound TerraSatch email.
# Inbound delivery also requires a Resend Receiving Emails domain/address configured
# in the Resend dashboard. Do not replace existing root-domain MX records blindly;
# follow the exact Resend DNS/forwarding records for the chosen receiving setup.
# TERRASATCH_BILLING_FROM=TerraSatch Billing <billing@terrasatch.com>
# TERRASATCH_BILLING_REPLY_TO=support@terrasatch.com
# Optional operational integration sender. When omitted, TerraSatch uses
# TERRASATCH_BILLING_FROM as a compatibility fallback for approved notification.send email.
# TERRASATCH_INTEGRATION_EMAIL_FROM=TerraSatch Operations <operations@terrasatch.com>
# TERRASATCH_INTEGRATION_EMAIL_REPLY_TO=support@terrasatch.com
#
# Optional fallback only: the API may call the protected Vercel billing sender
# when direct Resend credentials are intentionally not stored on the API/worker.
# TERRASATCH_BILLING_EMAIL_WEBHOOK_URL=https://terrasatch.com/api/billing-email
# TERRASATCH_BILLING_EMAIL_WEBHOOK_SECRET=<random-server-to-server-secret>

# Registration guardrails. Existing nodes/users keep operating when a limit is
# reached; only new Edge registrations or newly active portal users are paused.
TERRASATCH_MAX_EDGE_DEVICES=100
TERRASATCH_MAX_PORTAL_USERS=250
# Keep the API loopback-only by default. For a trusted-LAN preview, provide
# TERRASATCH_API_BIND_ADDRESS=0.0.0.0 and TERRASATCH_LAN_HOST=<LAN-IP> for one
# `docker compose up` command. Do not save that bind address in this file.
# For public hosting from this computer through the optional Cloudflare Tunnel
# profile, set the following values in an untracked .env file. Create a tunnel
# in Cloudflare Zero Trust with public hostname api.terrasatch.com and service
# http://api:8000, then run `docker compose --profile public-tunnel up -d`.
# TERRASATCH_ENV=production
# TERRASATCH_DEPLOYMENT_NAME=cloudflare-tunnel
# TERRASATCH_API_BASE_URL=https://api.terrasatch.com
# TERRASATCH_CORS_ORIGINS=https://terrasatch.com,https://www.terrasatch.com
# CLOUDFLARE_TUNNEL_TOKEN=<tunnel-token-from-cloudflare>
# Bootstrap web administration is disabled until all three settings are set.
# Generate these with `terrasatch admin configure` and keep them only in an
# owner-readable deployment environment file or secret manager.
# TERRASATCH_ADMIN_EMAIL=admin@example.com
# TERRASATCH_ADMIN_PASSWORD_HASH=scrypt$16384$8$1$<salt-base64>$<hash-base64>
# TERRASATCH_ADMIN_SESSION_SECRET=<random-64-character-secret>
# Never commit production connection strings, signing keys, device credentials, or API keys.

# Required for recoverable single-use activation links. Keep secret and stable across retries.
TERRASATCH_BILLING_ACTIVATION_SIGNING_SECRET=
