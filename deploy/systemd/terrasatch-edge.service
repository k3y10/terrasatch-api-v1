[Unit]
Description=TerraSatch Edge Readiness Check
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=terrasatch
Group=terrasatch
WorkingDirectory=/opt/terrasatch-ai-radio-core
EnvironmentFile=-/etc/terrasatch/edge.env
ExecStart=/opt/terrasatch-ai-radio-core/.venv/bin/terrasatch edge doctor --check-api
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
