# Environment: local, development, staging, or production.
TERRASATCH_ENV=local
TERRASATCH_DEPLOYMENT_NAME=local
# Deployment tooling may set TERRASATCH_BUILD_SHA at runtime. Do not hard-code
# it in production .env; deploy/release-oracle.sh stamps the current Git revision.
# TERRASATCH_BUILD_SHA=unknown
TERRASATCH_API_BASE_URL=http://localhost:8000
TERRASATCH_DATABASE_URL=postgresql+asyncpg://terrasatch:terrasatch@localhost:5432/terrasatch
TERRASATCH_REDIS_URL=redis://localhost:6379/0
TERRASATCH_LOG_LEVEL=INFO
TERRASATCH_LOG_FORMAT=json
TERRASATCH_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:4173,http://127.0.0.1:4173
# Set true only when API documentation may be exposed to the public.
TERRASATCH_ENABLE_DOCS=true
# Registration guardrails. Existing nodes/users keep operating when a limit is
# reached; only new Edge registrations or newly active portal users are paused.
TERRASATCH_MAX_EDGE_DEVICES=100
TERRASATCH_MAX_PORTAL_USERS=250
# Keep the API loopback-only by default. For a trusted-LAN preview, provide
# TERRASATCH_API_BIND_ADDRESS=0.0.0.0 and TERRASATCH_LAN_HOST=<LAN-IP> for one
# `docker compose up` command. Do not save that bind address in this file.
# For public hosting from this computer through the optional Cloudflare Tunnel
# profile, set the following values in an untracked .env file. Create a tunnel
# in Cloudflare Zero Trust with public hostname api.terrasatch.com and service
# http://api:8000, then run `docker compose --profile public-tunnel up -d`.
# TERRASATCH_ENV=production
# TERRASATCH_DEPLOYMENT_NAME=cloudflare-tunnel
# TERRASATCH_API_BASE_URL=https://api.terrasatch.com
# TERRASATCH_CORS_ORIGINS=https://terrasatch.com,https://www.terrasatch.com
# CLOUDFLARE_TUNNEL_TOKEN=<tunnel-token-from-cloudflare>
# Bootstrap web administration is disabled until all three settings are set.
# Generate these with `terrasatch admin configure` and keep them only in an
# owner-readable deployment environment file or secret manager.
# TERRASATCH_ADMIN_EMAIL=admin@example.com
# TERRASATCH_ADMIN_PASSWORD_HASH=scrypt$16384$8$1$<salt-base64>$<hash-base64>
# TERRASATCH_ADMIN_SESSION_SECRET=<random-64-character-secret>

# Snowbird / flaikConnect integration.
# Keep disabled by default. Use fixture for the Snowbird preview without provider credentials.
TERRASATCH_FLAIK_MODE=disabled
# TERRASATCH_FLAIK_MODE=fixture
# Live flaikConnect uses OAuth2 client credentials. The auth/API URLs and credentials are
# provided by flaik for the authorized environment; never expose them in browser variables.
# TERRASATCH_FLAIK_MODE=live
# TERRASATCH_FLAIK_AUTH_URL=https://auth-<region>.<environment>.flaik.com/connect/token
# TERRASATCH_FLAIK_API_BASE_URL=https://api-<region>.<environment>.flaik.com
# TERRASATCH_FLAIK_CLIENT_ID=<server-only-client-id>
# TERRASATCH_FLAIK_CLIENT_SECRET=<server-only-client-secret>
# Read-only is sufficient for TerraSatch operational context.
TERRASATCH_FLAIK_SCOPE=flaik.connect.api.read
# flaik documents the modules but supplies environment-specific endpoint details during setup.
# Configure these only from Snowbird/flaik-provided API documentation; do not guess paths.
# TERRASATCH_FLAIK_CLASSES_PATH=/api/<authorized-class-management-path>
# TERRASATCH_FLAIK_TIMEKEEPING_PATH=/api/<authorized-timekeeping-path>
TERRASATCH_FLAIK_TIMEOUT_SECONDS=8
# Enables provider context in correlation workflows; radio ingestion itself remains independent.
TERRASATCH_FLAIK_ENRICH_TRANSMISSIONS=false

# Never commit production connection strings, signing keys, device credentials, API keys,
# flaik credentials, or other partner secrets.
