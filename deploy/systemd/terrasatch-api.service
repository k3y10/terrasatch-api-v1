[Unit]
Description=TerraSatch API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=terrasatch
Group=terrasatch
WorkingDirectory=/opt/terrasatch-ai-radio-core
EnvironmentFile=/etc/terrasatch/api.env
ExecStartPre=/opt/terrasatch-ai-radio-core/.venv/bin/alembic upgrade head
ExecStart=/opt/terrasatch-ai-radio-core/.venv/bin/terrasatch serve --host 127.0.0.1 --port 8000
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target