# Caddy obtains and renews TLS certificates after api.terrasatch.com resolves
# publicly to this host and inbound ports 80 and 443 are allowed.
api.terrasatch.com {
    encode zstd gzip

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "strict-origin-when-cross-origin"
        -Server
    }

    reverse_proxy 127.0.0.1:8000

    log {
        output file /var/log/caddy/terrasatch-api-access.json
        format json
    }
}